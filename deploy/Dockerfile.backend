# syntax=docker/dockerfile:1
#
# Single image for every Python process of Specula Threat:
# api (uvicorn), scheduler (python -m app.scheduler) and migrate (alembic).
# Build from the repository root:
#   docker build -f deploy/Dockerfile.backend -t specula-backend:local .

ARG PYTHON_IMAGE=python:3.12-slim-trixie

# --- builder: resolve and install dependencies with uv ------------------------
FROM ${PYTHON_IMAGE} AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /src

# Dependencies first, so code changes do not invalidate this layer.
COPY backend/pyproject.toml backend/uv.lock backend/README.md ./
RUN uv sync --locked --no-dev --no-install-project

COPY backend/ ./
RUN uv sync --locked --no-dev --no-editable

# --- runtime: minimal image, unprivileged user --------------------------------
FROM ${PYTHON_IMAGE} AS runtime

RUN groupadd --system --gid 10001 specula \
    && useradd --system --uid 10001 --gid specula --no-create-home --home-dir /app specula

ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY --from=builder /src/alembic.ini ./alembic.ini
COPY --from=builder /src/migrations ./migrations

USER specula
EXPOSE 8000

# Only the proxy can reach the api (internal network), so forwarded headers are trusted.
CMD ["uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
