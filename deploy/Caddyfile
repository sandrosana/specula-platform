# Specula Threat – reverse proxy (docs/architettura.md §2, decision #12).
#
# SPECULA_HOST              address the analysts use (default 10.128.4.106)
# SPECULA_ALLOWED_NETWORKS  client networks allowed until M4 adds login
#                           (space-separated CIDRs, default 10.128.4.0/24)

{
	# No public ACME: certificates come from Caddy's own local CA (self-signed root).
	local_certs
	# Clients that connect by IP address (e.g. Windows/Schannel) send no SNI:
	# without this, Caddy has no certificate to offer and aborts the handshake.
	default_sni {$SPECULA_HOST:10.128.4.106}
}

{$SPECULA_HOST:10.128.4.106} {
	tls internal

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	# `route` runs its directives in the order written. Outside a route Caddy
	# re-sorts directives (handle/reverse_proxy before respond), which would let
	# requests through before the network check. The CI images job tests this.
	route {
		# Until M4 (authentication) only the LAB network may reach the platform.
		@outside not remote_ip {$SPECULA_ALLOWED_NETWORKS:10.128.4.0/24}
		respond @outside "Forbidden" 403

		reverse_proxy /api/* api:8000

		# The React frontend arrives in M5.
		respond "Specula Threat – API at /api/v1/docs" 200
	}

	log {
		output stdout
		format json
	}
}
