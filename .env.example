# Specula Threat – environment configuration
#
# Copy to .env (never commit .env) and fill in the values.
# Docker Compose reads it with: docker compose --env-file .env -f deploy/docker-compose.yml ...
# Variables marked "(planned)" are documented in docs/architettura.md
# but not read by the code yet; they become active in the milestone noted.

# --- Application -------------------------------------------------------------
# development | test | production (Compose defaults to production)
ENVIRONMENT=production
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Database (Docker Compose) -------------------------------------------------
POSTGRES_USER=specula
POSTGRES_DB=specula
# Required. Must be URL-safe: generate it with `openssl rand -hex 32`.
POSTGRES_PASSWORD=

# Only when running the backend outside Docker (Compose builds it from the values above).
# Must use the postgresql+asyncpg:// scheme.
# DATABASE_URL=postgresql+asyncpg://specula:change-me@127.0.0.1:5432/specula

# --- Backup (docs/architettura.md §15) -----------------------------------------
# Required: age public key (age1...). The private key is kept off the host.
BACKUP_AGE_RECIPIENT=
# Host folder on the backup disk; it must contain the marker file .specula-backup-disk.
BACKUP_HOST_DIR=/mnt/specula-backup
# Daily run, local time.
BACKUP_TIME=02:30
TZ=Europe/Rome
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# --- Reverse proxy -------------------------------------------------------------
# Address used by the analysts; the self-signed certificate is issued for it.
SPECULA_HOST=10.128.4.106
# Client networks allowed to reach the platform until M4 adds login (space-separated CIDRs).
SPECULA_ALLOWED_NETWORKS=10.128.4.0/24

# --- Security (planned: M4) --------------------------------------------------
SECRET_KEY=

# --- Dashboard parameters (planned: M3/M5) -----------------------------------
INTEREST_COUNTRY=IT
EPSS_THRESHOLD=0.5

# --- Collectors ----------------------------------------------------------------
# Time zone of the collector schedules.
SCHEDULER_TIMEZONE=Europe/Rome
# Per-collector overrides (name with dots replaced by underscores, upper case):
#   COLLECTOR_<NAME>_ENABLED=false        disable a collector
#   COLLECTOR_<NAME>_SCHEDULE=2h          interval (30m, 2h, 1d) or cron "15 6 * * *"
#   COLLECTOR_<NAME>_CACHE_TTL=30m        HTTP cache TTL
# Example: COLLECTOR_ABUSECH_THREATFOX_ENABLED=false

# --- Sources -------------------------------------------------------------------
# Only the scheduler container receives these keys.
# Optional: raises the NVD rate limit.
NVD_API_KEY=
# Required: ransomware.live PRO API (the free v2 API is not used).
RANSOMWARE_LIVE_API_KEY=
ABUSECH_AUTH_KEY=
OTX_API_KEY=
# Optional: GeoLite2 database for the map.
MAXMIND_LICENSE_KEY=

# --- Network -------------------------------------------------------------------
# Outbound proxy for collectors (read through app.core.config, never from the
# environment by httpx). Empty in the current LAB: no proxy.
HTTPS_PROXY=
